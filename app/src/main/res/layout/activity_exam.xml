<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Bilah Atas Super Tipis (Jam, Refresh, Keluar) -->
    <LinearLayout
        android:id="@+id/examTopBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="#F4F4F5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnRefreshExam"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="↻ Muat Ulang"
            android:textColor="#18181B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/examClock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:textColor="#18181B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnExitExam"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#FEE2E2"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="✕ Keluar"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Garis Progress Loading Tipis -->
    <ProgressBar
        android:id="@+id/examProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="#18181B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/examTopBar" />

    <!-- Area Soal WebView Penuh -->
    <WebView
        android:id="@+id/examWebView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/examProgressBar" />

    <!-- Floating Toast Peringatan Pelanggaran -->
    <TextView
        android:id="@+id/tvWarningBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#FEE2E2"
        android:elevation="6dp"
        android:padding="14dp"
        android:text="⚠ Peringatan: Terdeteksi upaya keluar layar ujian!"
        android:textColor="#B91C1C"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/examTopBar" />

</androidx.constraintlayout.widget.ConstraintLayout>